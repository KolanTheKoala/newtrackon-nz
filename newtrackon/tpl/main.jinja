        <style>
        #nt-tablebar .dt-length, #nt-tablebar .dt-search { display: flex; align-items: center; gap: .5rem; margin: 0; }
        #nt-tablebar .dt-length label, #nt-tablebar .dt-search label { margin: 0; white-space: nowrap; }
        #nt-tablebar .dt-search { flex: 1 1 22rem; }
        #nt-tablebar .dt-search input { flex: 1; width: auto; margin: 0; }
        </style>
        <div id="nt-tablebar" class="d-flex flex-wrap align-items-center gap-3 mb-2">
            <button type="button" id="ntf-reset" class="btn btn-sm btn-danger">Reset</button>
            <span id="nt-count" class="fw-bold"></span>
        </div>
        <script>
        // Filter bar: DataTables search hook, so paging, the entry count and the auto-refresh keep working.
        $(function () {
            var KEY = 'nt-filters', BOXES = ['up', 'good', 'udp', 'http', 'v4', 'v6', 'peer'];
            var dt = $('#trackon_table').DataTable();
            var mine = ntGuessRegion();
            if (mine) { var o = $('#ntf-fast option[value="' + mine + '"]'); o.text(o.text() + ' (you)'); }
            function state() {
                var s = {region: $('#ntf-region').val(), fast: $('#ntf-fast').val()};
                BOXES.forEach(function (b) { s[b] = $('#ntf-' + b).is(':checked'); });
                return s;
            }
            function has(list, v) { return (' ' + (list || '') + ' ').indexOf(' ' + v + ' ') >= 0; }
            $.fn.dataTable.ext.search.push(function (settings, data, idx) {
                if (settings.nTable.id !== 'trackon_table') { return true; }
                var tr = dt.row(idx).node(); if (!tr) { return true; }
                var s = state(), d = tr.dataset, st = d.ntState || '';
                if (s.up && st === 'down') { return false; }
                if (s.good && st !== 'up_good' && st !== 'up_new') { return false; }
                if (s.udp !== s.http && d.ntProto !== (s.udp ? 'udp' : 'http')) { return false; }
                if (s.v4 && !has(d.ntFam, 'v4')) { return false; }
                if (s.v6 && !has(d.ntFam, 'v6')) { return false; }
                if (s.peer && d.ntPeer !== 'pass') { return false; }
                if (s.region && !has(d.ntRegion, s.region)) { return false; }
                if (s.fast && !has(d.ntFast, s.fast)) { return false; }
                return true;
            });
            try {
                var saved = JSON.parse(localStorage.getItem(KEY) || '{}');
                BOXES.forEach(function (b) { $('#ntf-' + b).prop('checked', !!saved[b]); });
                $('#ntf-region').val(saved.region || ''); $('#ntf-fast').val(saved.fast || '');
            } catch (e) {}
            $('#nt-filters').on('change', 'input, select', function () {
                try { localStorage.setItem(KEY, JSON.stringify(state())); } catch (e) {}
                dt.draw();
            });
            $('#ntf-reset').on('click', function () {
                BOXES.forEach(function (b) { $('#ntf-' + b).prop('checked', false); });
                $('#ntf-region, #ntf-fast').val('');
                try { localStorage.removeItem(KEY); } catch (e) {}
                dt.search('');
                $(dt.table().container()).find('.dt-search input').val('');
                dt.draw();
            });
            // one line under the filters: Reset, "x of y shown", entries per page, search
            var bar = $('#nt-tablebar'), wrap = $(dt.table().container());
            wrap.find('.dt-length').first().appendTo(bar);
            wrap.find('.dt-search').first().appendTo(bar);
            wrap.children('.dt-layout-row').first().hide();
            function count() { $('#nt-count').text(dt.rows({search: 'applied'}).count() + ' of ' + dt.rows().count() + ' shown'); }
            dt.on('draw', count);
            var hq = /^#q=(.+)/.exec(location.hash);
            if (hq) { var q = decodeURIComponent(hq[1]); dt.search(q); bar.find('.dt-search input').val(q); }
            dt.draw();
        });
        </script>
<table id="trackon_table"
               class="table display responsive table-striped table-bordered table-hover initially-hidden">
            <thead>
                <tr>
                    <th>Tracker URL</th>
                    <th class="nt-latcol">
                        <span title="Announce latency">Latency</span>
                    </th>
                    <th class="sorttable_numeric">Score *</th>
                    <th class="nt-last7">Last 7 days</th>
                    <th class="nt-last5">Last 24 hours</th>
                    <th class="status-col">Status</th>
                    <th class="sorttable_numeric">Checked</th>
                    <th class="sorttable_numeric">Update interval</th>
                    <th>IP address</th>
                    <th class="sortable">Country</th>
                    <th class="sortable">Network</th>
                    <th>Added</th>
                    <th class="none">Stats</th>
                    <th class="none">Same operator</th>
                </tr>
            </thead>
            {% set lt, dt = namespace(value=0), namespace(value=0) %}
            {% if trackers %}
                {% for t in trackers %}
                    {% set tg = nt_tags(t) %}<tr class="nt-row-{{ nt_rowcls(t) }}" data-nt-state="{{ nt_state(t) }}" data-nt-proto="{{ tg.proto }}" data-nt-fam="{{ tg.fam }}" data-nt-peer="{{ tg.peer }}" data-nt-region="{{ tg.region }}" data-nt-fast="{{ tg.fast }}">
                        <td>{{ t.url }}<a href="/tracker/{{ t.host|urlencode }}" class="nt-tlink" title="Tracker page: uptime and latency history"><i class="fa-solid fa-chart-line"></i></a>{% if t.operator_peers %}<span class="nt-grp" title="Same operator or server as: {{ t.operator_peers|join(", ") }}">&#10697;{{ t.operator_peers|length + 1 }}</span>{% endif %}</td>
                        <td class="right{% if t.region_lat %} nt-haslat{% endif %}{% if t.latency %} {{ 'nt-lat-g' if t.latency < 200 else ('nt-lat-o' if t.latency < 300 else 'nt-lat-r') }}{% endif %}"{% if t.region_lat %} title="Latency by region: {% for k, v in t.region_lat.items() %}{{ k }} {{ v }} ms{% if not loop.last %} &middot; {% endif %}{% endfor %} &mdash; median of recent checks per region; other regions via rotating VPN exits, tunnel time subtracted (&plusmn;10&ndash;20 ms)"{% endif %} data-sort="{{ t.latency if (t.status == 1 and t.latency is not none) else 999999 }}">{% if t.country_codes and t.country_codes[0] %}<span class="fi fi-{{ t.country_codes[0]|lower }} nt-latflag" title="{{ (t.countries or [''])[0] }}"></span>{% endif %}{% if t.status == 1 and t.latency is not none %}{{ [t.latency, 1]|max }} ms{% elif t.status != 1 %}<span class="nt-offl">Offline</span>{% else %}&mdash;{% endif %}</td>
                        <td class="nt-score" data-nt-age="{{ '%.2f' % ((nt_now() - (t.added or 0)) / 86400) }}" data-sort="{% if t.status == 1 %}{{ (t.uptime|round|int) * 100000 + 9999 - ([t.latency or 9999, 9999]|min) + 20000000 }}{% else %}{{ 19000000 - ([((nt_now() - (t.last_uptime or 0)) / 60)|int, 9000000]|min) }}{% endif %}">{% set nt_r = t.uptime|round|int %}{% set nt_n = [((nt_r / 20)|round|int), 5]|min %}<span class="nt-stars" title="{{ nt_n }} of 5 stars">{{ '★' * nt_n }}<span class="nt-star-off">{{ '☆' * (5 - nt_n) }}</span></span> {{ nt_r }}</td>
                        <td class="nt-dots nt-7d" title="Last 7 days, 1 day per dot (red if any check that day failed, grey = not monitored yet), oldest left">{% set ww = (t.historic|list)[-336:] %}{% set w = [none] * (336 - ww|length) + ww %}{% for d in range(7) %}{% set real = w[d*48:(d+1)*48]|reject("none")|list %}<span class="nt-dot {% if not real %}nt-dot-none{% elif 0 in real or 0.5 in real %}nt-dot-down{% else %}nt-dot-up{% endif %}"></span>{% endfor %}</td>
                        <td class="nt-dots nt-12h" title="Last 24 hours, 2 hours per dot (red if any check in those 2 hours failed), oldest left">{% set hh = (t.historic|list)[-48:] %}{% set h = [none] * (48 - hh|length) + hh %}{% for i in range(12) %}{% set p = h[4*i:4*i+4] %}<span class="nt-dot {% if p|reject("none")|list|length == 0 %}nt-dot-none{% elif 0 in p or 0.5 in p %}nt-dot-down{% else %}nt-dot-up{% endif %}"></span>{% endfor %}</td>
                        {% if t.status == 1 %}
                            <td data-sort="{{ t.status_epoch }}" class="{{ 'up' if nt_rowcls(t) == 'green' else 'nt-orange' }}">
