            {% set lt, dt = namespace(value=0), namespace(value=0) %}
            {% if trackers %}
                {% for t in trackers %}
                    {% set tg = nt_tags(t) %}{% set nt_dd = nt_dying(t) %}<tr class="nt-row-{{ nt_rowcls(t) }}{% if nt_dd is not none %} nt-dying" title="No answer for {{ nt_dd }}+ days: removed and banned for 30 days after 5{% endif %}" data-nt-host="{{ t.host }}" data-nt-state="{{ nt_state(t) }}" data-nt-proto="{{ tg.proto }}" data-nt-fam="{{ tg.fam }}" data-nt-peer="{{ tg.peer }}" data-nt-region="{{ tg.region }}" data-nt-fast="{{ tg.fast }}">
                        <td class="nt-url" data-search="{{ t.url }} {{ (t.countries or [])|join(' ') }} {{ (t.networks or [])|join(' ') }} {{ (t.ips or [])|join(' ') }}">{{ t.url }}<a href="/tracker/{{ t.host|urlencode }}" class="nt-tlink" title="Tracker page: uptime and latency history"><i class="fa-solid fa-chart-line"></i></a>{% if t.operator_peers %}<span class="nt-grp" title="Same operator or server as: {{ t.operator_peers|join(", ") }}">&#10697;{{ t.operator_peers|length + 1 }}</span>{% endif %}</td>
                        <td class="right{% if t.region_lat %} nt-haslat{% endif %}{% if t.latency and t.status == 1 %} {{ 'nt-lat-g' if t.latency < 200 else ('nt-lat-o' if t.latency < 300 else 'nt-lat-r') }}{% endif %}"{% if t.region_lat %} title="Latency by region: {% for k, v in t.region_lat.items() %}{{ k }} {{ v }} ms{% if not loop.last %} &middot; {% endif %}{% endfor %} &mdash; median of recent checks per region; other regions via rotating VPN exits, tunnel time subtracted (&plusmn;10&ndash;20 ms)"{% endif %} data-sort="{{ t.latency if (t.status == 1 and t.latency is not none) else 999999 }}">{% if t.country_codes and t.country_codes[0] %}<span class="fi fi-{{ t.country_codes[0]|lower }} nt-latflag" title="{{ (t.countries or [''])[0] }}"></span>{% endif %}{% if t.status == 1 and t.latency is not none %}{{ [t.latency, 1]|max }} ms{% elif t.status != 1 %}<span class="nt-offl">Offline</span>{% else %}&mdash;{% endif %}</td>
                        <td class="nt-score" data-nt-age="{{ '%.2f' % ((nt_now() - (t.added or 0)) / 86400) }}" data-sort="{% if t.status == 1 %}{{ (t.uptime|round|int) * 100000 + 9999 - ([t.latency or 9999, 9999]|min) + 20000000 }}{% else %}{{ 19000000 - ([((nt_now() - (t.last_uptime or 0)) / 60)|int, 9000000]|min) }}{% endif %}">{% set nt_r = t.uptime|round|int %}{% set nt_n = [((nt_r / 20)|round|int), 5]|min %}<span class="nt-stars" title="{{ nt_n }} of 5 stars">{{ '★' * nt_n }}<span class="nt-star-off">{{ '☆' * (5 - nt_n) }}</span></span> {{ nt_r }}</td>
