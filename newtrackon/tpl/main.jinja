{% endblock head %}
{% block body %}
    <script>
    $(document).ready(function () {
        $('#trackon_table').DataTable({
            pageLength: 100,
            order: [[2, 'desc']],
            columnDefs: [
                {type: 'num', targets: 1},
                {orderable: false, targets: [4, 6]}
            ],
            autoWidth: false
        });
        $(".initially-hidden").css("visibility", "visible");
    });
    </script>
    <div class="container">
        <script src="/static/js/region-guess.js"></script>
        <h1 class="h3 text-center mt-3">Tracker Status</h1>
        <p class="text-center mb-2">Live health checks of public BitTorrent trackers.</p>
        <p class="text-center">
            <b>Your tracker list<span id="nt-yl-where"></span>:</b>
            <code id="nt-yl">https://newtrackon.co.nz/api/clean</code>
            <button type="button" class="btn btn-sm btn-primary ms-1" id="nt-yl-copy">Copy</button>
            &middot; <a href="/list">more options</a> &middot; <a href="/clients">how to use it</a>
        </p>
        <script>
        (function () {
            var r = ntGuessRegion(), url = location.origin + '/api/clean' + (r ? '?fast_from=' + r : '');
            document.getElementById('nt-yl').textContent = url;
            if (r) { document.getElementById('nt-yl-where').textContent = ' (' + NT_REGION_NAMES[r] + ')'; }
            document.getElementById('nt-yl-copy').addEventListener('click', function () {
                var b = this;
                navigator.clipboard.writeText(url).then(function () { b.textContent = 'Copied!'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
            });
        })();
        </script>
        <form method="post" action="/" class="mx-auto mb-2" style="max-width: 720px">
            <div class="d-flex gap-2 align-items-start">
                <textarea class="form-control" rows="1" id="textArea" name="new_trackers" placeholder="Submit trackers: announce URLs, one per line"></textarea>
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
            {% if form_feedback == "EMPTY" %}
                <div class="alert alert-warning mt-2 mb-0" role="alert">
                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                    <span class="visually-hidden">Error:</span>
                    No trackers were submitted
                </div>
            {% elif form_feedback == "SUCCESS" %}
                <div class="alert alert-info mt-2 mb-0" role="alert">
                    Received, see the progress in the <strong><a class="alert-link" href="/submitted">Submitted</a></strong> section
                </div>
            {% elif form_feedback == "LIMIT" %}
                <div class="alert alert-warning mt-2 mb-0" role="alert">
                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                    <span class="visually-hidden">Error:</span>
                    {{ form_reason }}
                </div>
            {% endif %}
        </form>
    </div>
    <style>td.nt-haslat{cursor:help;text-decoration:underline dotted rgba(255,255,255,.45);text-underline-offset:3px}.nt-grp{margin-left:6px;font-size:.75em;color:#8ab4ff;cursor:help;vertical-align:1px}</style>
    <div class="container-fluid table-responsive">
        <div class="nt-upd" style="font-size:.85rem;opacity:.75;margin:4px 0 8px">Last updated <span id="nt-upd" data-nt-ts="{{ nt_now() }}">just now</span></div>
        {% set hl = nt_health() %}<div class="nt-health" style="font-size:.85rem;opacity:.75;margin:-4px 0 8px">{% if not hl.online %}<span style="color:#ffa500">&#9888; Monitor offline: checks are paused until its connection is back, and nothing is counted against trackers meanwhile.</span>{% else %}Monitor: {{ hl.checks_hour }} check{{ "" if hl.checks_hour == 1 else "s" }} in the last hour{% if hl.last_ago %} &middot; last {{ hl.last_ago }}{% endif %} &middot; latency from {{ hl.regions|join(", ") if hl.regions else "this server only" }}{% endif %}</div>
<script>(function(){var el=document.getElementById('nt-upd');if(!el)return;var ts=+el.dataset.ntTs;
function fmt(){var d=new Date(ts*1000),a=Math.max(0,Math.round(Date.now()/1000-ts)),ag=a<60?a+' s':a<3600?Math.floor(a/60)+' min':Math.floor(a/3600)+' h';
el.textContent=d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit',timeZoneName:'short'})+' \u00b7 '+ag+' ago'}
var of=window.fetch;window.fetch=function(){var p=of.apply(this,arguments);p.then(function(r){if(r.ok&&/text\/html/.test(r.headers.get('content-type')||''))r.clone().text().then(function(t){var m=/data-nt-ts="(\d+)"/.exec(t);if(m){ts=+m[1];fmt()}})}).catch(function(){});return p};
fmt();setInterval(fmt,1000)})();</script>
<div id="nt-filters" class="d-flex flex-wrap align-items-center gap-2 my-2">
            <span class="fw-bold me-1">Show only:</span>
            <input type="checkbox" class="btn-check" id="ntf-up" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-up">Up now</label>
            <input type="checkbox" class="btn-check" id="ntf-good" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-good">Up/Good</label>
            <input type="checkbox" class="btn-check" id="ntf-udp" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-udp">UDP</label>
            <input type="checkbox" class="btn-check" id="ntf-http" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-http">HTTP(S)</label>
            <input type="checkbox" class="btn-check" id="ntf-v4" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-v4">IPv4 works</label>
            <input type="checkbox" class="btn-check" id="ntf-v6" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-v6">IPv6 works</label>
            <input type="checkbox" class="btn-check" id="ntf-peer" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-peer">Passes peer test</label>
            <select id="ntf-region" class="form-select form-select-sm w-auto" aria-label="Located in">
                <option value="">Located anywhere</option>
                <option value="americas">Located in the Americas</option>
                <option value="europe">Located in Europe, Middle East &amp; Africa</option>
                <option value="asia-pacific">Located in Asia-Pacific</option>
            </select>
            <select id="ntf-fast" class="form-select form-select-sm w-auto" aria-label="Fast from">
                <option value="">Fast from anywhere</option>
                <option value="oceania">Fast from Australia, NZ &amp; Pacific</option>
                <option value="asia">Fast from Asia</option>
                <option value="europe">Fast from Europe, Middle East &amp; Africa</option>
                <option value="americas">Fast from the Americas</option>
            </select>
