if s.peer %}<span class="k">Peer test</span><span class="v">passed {{ s.peer.split('/')[0] }} of its last {{ s.peer.split('/')[1] }} (3 fails marks it Up/Bad)</span>{% endif %}{% if s.ann_iv %}<span class="k">Announce interval</span><span class="v">{{ s.ann_iv // 60 }} min (set by the tracker)</span>{% endif %}{% if t.region_lat %}<span class="k">Latency by region</span><span class="v">{% for k, v in t.region_lat.items() %}{{ k }} {{ v }} ms{% if not loop.last %} &middot; {% endif %}{% endfor %}</span>{% endif %}</div></td>
