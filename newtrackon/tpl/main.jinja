<script id="nt-refresh">
(function () {
  var EVERY = 120000, busy = false, last = Date.now();
  function refresh() {
    if (busy || document.hidden || !window.jQuery || !jQuery.fn.dataTable) return;
    var t = jQuery.fn.dataTable.tables()[0];
    if (!t || t.querySelector('tr.shown, tr.parent')) return;   // don't yank an expanded row
    busy = true;
    fetch(location.pathname + location.search, { cache: 'no-store', credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw 0; return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var nt = (t.id && doc.getElementById(t.id)) || doc.querySelector('table');
        var rows = nt ? nt.querySelectorAll('tbody > tr') : [];
        if (!rows.length) return;
        var dt = jQuery(t).DataTable();
        dt.clear(); dt.rows.add(Array.prototype.slice.call(rows)); dt.draw(false);  // keeps sort, page, search
        last = Date.now();
      })
      .catch(function () {})
      .then(function () { busy = false; });
  }
  setInterval(refresh, EVERY);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && Date.now() - last > EVERY) refresh();
  });
})();
</script>
<script id="nt-ago">
(function () {
  function f(s) {
    var m = Math.floor(s / 60), h = Math.floor(m / 60), d = Math.floor(h / 24);
    if (d > 0) return d + 'd ' + (h % 24) + 'h';
    if (h > 0) return h + 'h' + (m % 60 ? ' ' + (m % 60) + 'm' : '');
    return m + 'm';
  }
  function run() {
    var n = Date.now() / 1000;
    document.querySelectorAll('[data-nt-ts]').forEach(function (e) {
      var t = +e.getAttribute('data-nt-ts');
      e.textContent = t ? f(Math.max(0, n - t)) : '\u2014';
    });
  }
  document.addEventListener('DOMContentLoaded', function () {
    run();
    if (window.jQuery) jQuery(document).on('draw.dt', run);
  });
  setInterval(run, 30000);
})();
</script>
