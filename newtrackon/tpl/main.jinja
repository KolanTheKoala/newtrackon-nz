and t.deadfam.fam == k and t.deadfam.n >= 3) else '#28a745') if k in t.fams else '#000' }}">IPv{{ k[1] }}</b>{% endfor %}</span>{% endif %}{% if t.inflated %}<span class="nt-peerwarn nt-infl" title="Inflated counts: reported {{ t.inflated[0] }} seeders / {{ t.inflated[1] }} leechers for a random torrent only we know about (the truth is 1 / 1). Flag only, no penalty.">&#9650;</span>{% endif %}{% if t.stale %}<span class="nt-peerwarn nt-stale" title="Keeps handing out peers after they have left (ignores the &quot;stopped&quot; event), so clients waste time on dead peers. Flag only, no penalty.">&#8856;</span>{% endif %}{% if t.url.startswith("http") and t.status == 1 %}<span class="nt-shield nt-shield-ok" title="Security: HTTP(S) trackers run over TCP, whose handshake makes spoofed announces impossible."><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align:-1px"><path d="M8 0 1.5 2.5v5c0 4 2.8 7.2 6.5 8.5 3.7-1.3 6.5-4.5 6.5-8.5v-5z"/></svg></span>{% elif t.status == 1 and t.cid_ok is sameas true %}<span class="nt-shield nt-shield-ok" title="Security: enforces the UDP connection-ID handshake (BEP 15), so it cannot be used to aim spoofed traffic at others."><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align:-1px"><path d="M8 0 1.5 2.5v5c0 4 2.8 7.2 6.5 8.5 3.7-1.3 6.5-4.5 6.5-8.5v-5z"/></svg></span>{% elif t.status == 1 and t.cid_ok is sameas false %}<span class="nt-shield nt-shield-bad" title="Security: accepted an announce with a made-up connection ID. Anyone can spoof announces through it, e.g. to point swarm traffic at a victim. No penalty."><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align:-1px"><path d="M8 0 1.5 2.5v5c0 4 2.8 7.2 6.5 8.5 3.7-1.3 6.5-4.5 6.5-8.5v-5z"/></svg></span>{% elif t.status == 1 and t.url.startswith("udp") %}<span class="nt-shield nt-shield-na" title="Security: not tested yet. The UDP connection-ID (BEP 15) check has not compl