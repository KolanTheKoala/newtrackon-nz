        #trackon_table { margin-left: calc(var(--bs-gutter-x, 1.5rem) * -.5); margin-right: calc(var(--bs-gutter-x, 1.5rem) * -.5); width: calc(100% + var(--bs-gutter-x, 1.5rem)) !important; }
        /* key: each entry reads as one line, symbol first */
