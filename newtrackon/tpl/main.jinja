eted for this tracker, usually because it has not stayed up long enough."><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align:-1px"><path d="M8 0 1.5 2.5v5c0 4 2.8 7.2 6.5 8.5 3.7-1.3 6.5-4.5 6.5-8.5v-5z"/></svg></span>{% endif %}{% set fx = nt_fix(t) %}{% if fx %}<a class="nt-fixlink" href="/fix#{{ fx }}" title="How to fix: {{ nt_fix_titles[fx] }}"><i class="fa-solid fa-wrench"></i></a>{% endif %}</b>
                            </td>
                            {% set lt.value = lt.value + 1 %}
