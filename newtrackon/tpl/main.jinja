        .nt-ev { grid-template-columns: auto 1fr !important; column-gap: .8em !important; row-gap: 0 !important; line-height: 1.45 !important;
                 padding: 6px 0; border-bottom: 1px solid rgba(255, 255, 255, .08); }
        .nt-ev > span:first-child { white-space: nowrap; opacity: .7; }
