        <meta name="description" content="{{ description or 'New Zealand (Wellington) fork of newTrackon — public BitTorrent tracker status from an NZ vantage point.' }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#131A60">
        <meta name="author" content="Miguel Angel Corral Peltzer">
        <script data-cfasync="false" src="/static/js/theme-v2.js"></script>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32">
        <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16">
        <link rel="manifest" href="/manifest.json">
        <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#131A60">
