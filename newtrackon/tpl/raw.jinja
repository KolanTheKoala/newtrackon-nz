{% extends "base.jinja" %}
{% block body %}
<style>/* nt-flags */ td.nt-flags{white-space:nowrap} .nt-peerwarn{margin-left:4px;cursor:help;color:#f5c518} .nt-peerok{color:#28a745} .nt-peerpen,.nt-peerdown{color:#dc3545} .nt-fake{color:#f5c518} .nt-infl{color:#ffa500;font-size:.8em} .nt-stale{color:#ffa500} .nt-shield{margin-left:4px;cursor:help} .nt-shield-ok{color:#28a745} .nt-shield-bad{color:#dc3545}</style>
    <div class="container">
        <h2>Raw data</h2>
        <p>
            This is the information about the response of the last 600 trackers contacted, for research and debugging
            purposes.
            These include only trackers already in the list.
        </p>
        <p>The trackers are queried with a random hash.</p>
    </div>
    {% if data %}
        <div class="container-fluid">
            <div class="table-responsive">
                <table class="sortable table table-responsive table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Tracker</th>
                            <th>IP</th>
                            <th>Result</th>
                            <th>Flags</th>
                            <th>Response/Error</th>
                        </tr>
                    </thead>
                    {% for response in data %}
                        <tr>
                            <td>{{ response.get("time") | format_timestamp }}</td>
                            <td>{{ response.get("url") }}</td>
                            <td>{% if response.get("ip") %}{{ response.get("ip") }}{% endif %}</td>
                            {% if response.get("status") == 1 %}
                                <td class="up">
                                    <b>Up</b>
                                </td>
                            {% else %}
                                <td class="down">
                                    <b>Down</b>
                                </td>
                            {% endif %}
                            <td class="nt-flags">{% set f = response.get("flags") %}{% if response.get("status") != 1 %}<span class="nt-peerwarn nt-peerdown" title="Down: this check failed.">&#10008;</span>{% elif f %}{% if f.fake3 %}<span class="nt-peerwarn nt-peerpen" title="Fake peers 3+ checks in a row: score set to 0.">&#9760;</span>{% elif f.fake %}<span class="nt-peerwarn nt-fake" title="Returned {{ f.fake }} fake peer(s) for a random torrent only we know about.">&#9760;</span>{% elif f.peer3 %}<span class="nt-peerwarn nt-peerpen" title="Failed 3+ of its last 6 peer tests: score set to 0.">&#9888;</span>{% elif f.peer_ok is sameas false %}<span class="nt-peerwarn" title="Peer test failed: did not hand our peer to a second client.">&#9888;</span>{% elif f.peer_ok is sameas true %}<span class="nt-peerwarn nt-peerok" title="Peer test passed.">&#10004;</span>{% endif %}{% if f.inflated %}<span class="nt-peerwarn nt-infl" title="Inflated counts: reported {{ f.inflated[0] }} seeders / {{ f.inflated[1] }} leechers (truth 1 / 1).">&#9650;</span>{% endif %}{% if f.stale %}<span class="nt-peerwarn nt-stale" title="Kept handing out a peer after it sent stopped.">&#8856;</span>{% endif %}{% if (response.get("url") or "").startswith("http") %}<span class="nt-shield nt-shield-ok" title="Security: HTTP(S) trackers run over TCP, whose handshake makes spoofed announces impossible."><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align:-1px"><path d="M8 0 1.5 2.5v5c0 4 2.8 7.2 6.5 8.5 3.7-1.3 6.5-4.5 6.5-8.5v-5z"/></svg></span>{% elif f.cid_ok is sameas true %}<span class="nt-shield nt-shield-ok" title="Refused a made-up UDP connection ID (spoof-proof)."><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align:-1px"><path d="M8 0 1.5 2.5v5c0 4 2.8 7.2 6.5 8.5 3.7-1.3 6.5-4.5 6.5-8.5v-5z"/></svg></span>{% elif f.cid_ok is sameas false %}<span class="nt-shield nt-shield-bad" title="Accepted a made-up UDP connection ID (spoofable)."><svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" style="vertical-align:-1px"><path d="M8 0 1.5 2.5v5c0 4 2.8 7.2 6.5 8.5 3.7-1.3 6.5-4.5 6.5-8.5v-5z"/></svg></span>{% endif %}{% endif %}</td>
                            <td>{{ response.get("info") | e }}</td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
{% set title = "Raw Data - newTrackon" %}
