{% extends "base.jinja" %}
{% block head %}
    <style>
    .nt-bans table { width: 100%; max-width: 980px; font-size: .92rem; margin-left: 0; }
    .nt-bans td, .nt-bans th { padding: .35rem .5rem; vertical-align: top; }
    .nt-bans th { font-weight: 600; opacity: .7; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
    .nt-bans td.h { white-space: normal !important; overflow-wrap: anywhere; }
    .nt-bans td.d { white-space: nowrap; }
    .nt-bans td.w { white-space: normal !important; }
    @media (max-width: 576px) { .nt-bans td, .nt-bans th { font-size: .82rem; padding: .3rem .3rem; } }
    </style>
{% endblock head %}
{% block body %}
<div class="container nt-bans">
    <h2>Banned trackers</h2>
    <p>Trackers this site removed (no answer or Up/Bad for 5 days, Up/Junk for 30, too unreliable, private or whitelist-only) can't be
       submitted again for 30 days: 90 days the second time, never after the third. Most recent first. Each tracker's page has its
       history, and once it's fixed it can come back early: press <b>Check again now</b> there (not for bans for good).</p>
    <p><a href="/submitted">&larr; Submitted trackers</a></p>
    {% if bans %}
    <div class="table-responsive">
        <table class="table table-sm">
            <thead><tr><th>Tracker</th><th>Why it was removed</th><th>Removed</th><th>Banned until</th></tr></thead>
            <tbody>{% for b in bans %}
                <tr><td class="h"><a href="/tracker/{{ b.host|urlencode }}">{{ b.host }}</a></td>
                    <td class="w">{{ b.reason or "" }}</td>
                    <td class="d">{{ nt_date(b.removed) if b.removed else "" }}</td>
                    <td class="d">{{ nt_date(b.until) if b.until else "for good" }}</td></tr>{% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}<p>None right now.</p>{% endif %}
</div>
{% endblock body %}
