{% extends "base.jinja" %}
{% block head %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.11/clipboard.min.js"
            integrity="sha512-7O5pXpc0oCRrxk8RUfDYFgn0nO1t+jLuIOQdOMRp4APB7uZ4vSjspzp5y6YDtDs4VzUSTbWzBFZ/LKJhnyFOKw=="
            crossorigin="anonymous"></script>
    <script src="/static/js/region-guess.js"></script>
{% endblock head %}
{% block body %}
    <div class="container">
        <h2>Stable trackers</h2>
        <p>Trackers with a score of 90+, up now and listed for at least 7 days. Narrow it down, then copy it into your client.</p>
        <div id="nt-filters" class="d-flex flex-wrap align-items-center gap-2 my-2">
            <span class="fw-bold me-1">Show only:</span>
            <input type="checkbox" class="btn-check" id="ntf-good" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-good">Up/Good</label>
            <input type="checkbox" class="btn-check" id="ntf-udp" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-udp">UDP</label>
            <input type="checkbox" class="btn-check" id="ntf-http" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-http">HTTP(S)</label>
            <input type="checkbox" class="btn-check" id="ntf-v4" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-v4">IPv4 works</label>
            <input type="checkbox" class="btn-check" id="ntf-v6" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-v6">IPv6 works</label>
            <input type="checkbox" class="btn-check" id="ntf-peer" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-peer">Passes peer test</label>
            <input type="checkbox" class="btn-check" id="ntf-new" autocomplete="off"><label class="btn btn-sm btn-outline-secondary" for="ntf-new">Include new</label>
            <select id="ntf-region" class="form-select form-select-sm w-auto" aria-label="Located in">
                <option value="">Located anywhere</option>
                <option value="americas">Located in the Americas</option>
                <option value="europe">Located in Europe, Middle East &amp; Africa</option>
                <option value="asia-pacific">Located in Asia-Pacific</option>
            </select>
            <select id="ntf-fast" class="form-select form-select-sm w-auto" aria-label="Fast from">
                <option value="">Fast from anywhere</option>
                <option value="oceania">Fast from Australia, NZ &amp; Pacific</option>
                <option value="asia">Fast from Asia</option>
                <option value="europe">Fast from Europe, Middle East &amp; Africa</option>
                <option value="americas">Fast from the Americas</option>
            </select>
            <button type="button" id="ntf-reset" class="btn btn-sm btn-link">Reset</button>
        </div>
        <p>
            <button class="btn btn-primary btn-copy" data-clipboard-action="copy" data-clipboard-target="#tocopy">
                Copy <b id="size">0</b> trackers to clipboard
            </button>
        </p>
        <div id="list">
            <pre id="tocopy">Loading...</pre>
        </div>
        <p class="mt-2">
            <b>Same list from the API</b> (for clients that load trackers from a URL):<br>
            <code id="api-url">https://newtrackon.co.nz/api/stable</code>
            <button type="button" class="btn btn-sm btn-primary ms-1" id="api-copy">Copy</button>
        </p>
    </div>
    <script>
    (function () {
        var KEY = 'nt-list-filters', BOXES = ['good', 'udp', 'http', 'v4', 'v6', 'peer', 'new'];
        var POINTS = {americas: 'North America', europe: 'Europe', asia: 'Asia', oceania: 'Oceania'};
        var trackers = [];
        var mine = ntGuessRegion();
        if (mine) { var o = $('#ntf-fast option[value="' + mine + '"]'); o.text(o.text() + ' (you)'); }

        function state() {
            var s = {region: $('#ntf-region').val(), fast: $('#ntf-fast').val()};
            BOXES.forEach(function (b) { s[b] = $('#ntf-' + b).is(':checked'); });
            return s;
        }
        function keep(t, s, now) {
            if (t.status === 'down' || Math.round(t.score) < 90) { return false; }               // the stable list
            if (!s['new'] && now - t.added < 7 * 86400) { return false; }
            if (s.good && t.status !== 'up_good' && t.status !== 'up_new') { return false; }
            var udp = t.url.indexOf('udp:') === 0;
            if (s.udp !== s.http && udp !== s.udp) { return false; }
            if (s.v4 && t.families.v4 !== 'ok') { return false; }
            if (s.v6 && t.families.v6 !== 'ok') { return false; }
            if (s.peer && t.peer_test.latest !== 'pass') { return false; }
            if (s.region && (t.regions || []).indexOf(s.region) < 0) { return false; }
            if (s.fast) { var ms = (t.latency_by_region_ms || {})[POINTS[s.fast]]; if (typeof ms !== 'number' || ms >= 150) { return false; } }
            return true;
        }
        function render() {
            var s = state(), now = Date.now() / 1000;
            var urls = trackers.filter(function (t) { return keep(t, s, now); })
                .sort(function (a, b) { return Math.round(b.score) - Math.round(a.score) || (a.latency_ms || 99999) - (b.latency_ms || 99999); })
                .map(function (t) { return t.url; });
            $('#tocopy').text(urls.length ? urls.join('\n\n') + '\n' : 'No trackers match these filters.');
            $('#size').text(urls.length);
            var q = [];
            if (s['new']) { q.push('min_age_days=0'); }
            if (s.good) { q.push('good=1'); }
            if (s.udp !== s.http) { q.push('protocol=' + (s.udp ? 'udp' : 'http')); }
            if (s.v4) { q.push('ipv4_works=1'); }
            if (s.v6) { q.push('ipv6_works=1'); }
            if (s.peer) { q.push('passes_peer_test=1'); }
            if (s.region) { q.push('region=' + s.region); }
            if (s.fast) { q.push('fast_from=' + s.fast); }
            $('#api-url').text(location.origin + '/api/stable' + (q.length ? '?' + q.join('&') : ''));
            try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {}
        }

        var saved = null;
        try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
        if (saved) {
            BOXES.forEach(function (b) { $('#ntf-' + b).prop('checked', !!saved[b]); });
            $('#ntf-region').val(saved.region || ''); $('#ntf-fast').val(saved.fast || '');
        } else {
            $('#ntf-v4').prop('checked', true);   // most clients are IPv4-only
            if (mine) { $('#ntf-fast').val(mine); }
        }
        $('#nt-filters').on('change', 'input, select', render);
        $('#ntf-reset').on('click', function () {
            BOXES.forEach(function (b) { $('#ntf-' + b).prop('checked', false); });
            $('#ntf-region, #ntf-fast').val('');
            render();
        });
        $.getJSON('/api/details', function (d) { trackers = d; render(); });
    })();

    function setTooltip(btn, message) {
        var tooltip = bootstrap.Tooltip.getInstance(btn);
        if (tooltip) { tooltip.hide(); }
        btn.setAttribute('data-bs-title', message);
        tooltip = new bootstrap.Tooltip(btn, {trigger: 'manual', placement: 'bottom'});
        tooltip.show();
    }
    function hideTooltip(btn) {
        setTimeout(function () { var t = bootstrap.Tooltip.getInstance(btn); if (t) { t.hide(); } }, 1000);
    }
    $('#api-copy').on('click', function () {
        var b = this;
        navigator.clipboard.writeText($('#api-url').text()).then(function () { b.textContent = 'Copied!'; setTimeout(function () { b.textContent = 'Copy'; }, 1500); });
    });
    var clipboard = new ClipboardJS('.btn-copy');
    clipboard.on('success', function (e) { setTooltip(e.trigger, 'Copied!'); hideTooltip(e.trigger); });
    clipboard.on('error', function (e) { setTooltip(e.trigger, 'Failed!'); hideTooltip(e.trigger); });
    </script>
{% endblock %}
{% set title = "Stable Trackers List - newTrackon" %}
