{% extends "base.jinja" %}
{% block head %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.11/clipboard.min.js"
            integrity="sha512-7O5pXpc0oCRrxk8RUfDYFgn0nO1t+jLuIOQdOMRp4APB7uZ4vSjspzp5y6YDtDs4VzUSTbWzBFZ/LKJhnyFOKw=="
            crossorigin="anonymous"></script>
    <script src="/static/js/region-guess.js"></script>
{% endblock head %}
{% block body %}
    <script>
    var selectedList = 'api/stable?include_ipv4_only_trackers=1&include_ipv6_only_trackers=0&min_age_days=7'

    function setTooltip(btn, message) {
        var tooltip = bootstrap.Tooltip.getInstance(btn);
        if (tooltip) {
            tooltip.hide();
        }
        btn.setAttribute('data-bs-title', message);
        tooltip = new bootstrap.Tooltip(btn, {trigger: 'manual', placement: 'bottom'});
        tooltip.show();
    }

    function hideTooltip(btn) {
        setTimeout(function () {
            var tooltip = bootstrap.Tooltip.getInstance(btn);
            if (tooltip) {
                tooltip.hide();
            }
        }, 1000);
    }

    function getTrackers(api_url) {
        $.get({
            url: api_url,
            data: null,
            success: function (text) {
                $('#tocopy').text(text);
                size = (text.match(/^\s*\S/gm) || "").length;
                $('#size').text(size);
            },
            dataType: 'text'
        });
    }

    // the list URL is built from the current state of every control
    function buildList() {
        var p = [
            'include_ipv4_only_trackers=' + ($('#include_ipv4_only').is(':checked') ? 1 : 0),
            'include_ipv6_only_trackers=' + ($('#include_ipv6_only').is(':checked') ? 1 : 0),
            'min_age_days=' + ($('#include_trackers_newer_than_10_days').is(':checked') ? 0 : 7)
        ];
        if ($('#region').val()) { p.push('region=' + $('#region').val()); }
        if ($('#fast_from').val()) { p.push('fast_from=' + $('#fast_from').val()); }
        return 'api/stable?' + p.join('&');
    }

    $(document).ready(function () {
        var guess = ntGuessRegion();
        if (guess) {
            $('#fast_from').val(guess);
            $('#region-note').text('Showing trackers that are fast from ' + $('#fast_from option:selected').text() +
                ' (guessed from your time zone). Change it below if that is wrong.').show();
            selectedList = buildList();
        }
        getTrackers(selectedList);
        $('#include_ipv4_only, #include_ipv6_only, #include_trackers_newer_than_10_days, #region, #fast_from').change(function () {
            selectedList = buildList();
            getTrackers(selectedList);
        });
    });

    var clipboard = new ClipboardJS('.btn-copy');

    clipboard.on('success', function (e) {
        setTooltip(e.trigger, 'Copied!');
        hideTooltip(e.trigger);
    });

    clipboard.on('error', function (e) {
        setTooltip(e.trigger, 'Failed!');
        hideTooltip(e.trigger);
    });
    </script>
    <div class="container">
        <h2>List of stable trackers</h2>
        <p>
            This is a list of trackers with a score of 90 or more and at least 7 days of history by default, considered stable.
            You can copy the list and add it to your torrents or directly to your BitTorrent client.
            Narrow it to trackers located in a region, or to trackers that answer quickly from a region
            (under 150 ms, measured from North America, Europe, Asia or Wellington NZ).
        </p>
        <div class="row">
            <div class="col-lg-3">
                <p>
                    <button class="btn btn-primary btn-copy"
                            data-clipboard-action="copy"
                            data-clipboard-target="#tocopy">
                        Copy <b id="size"></b>
                        trackers to clipboard
                    </button>
                </p>
            </div>
            <div class="col-lg-3">
                <p>
                    <label class="btn btn-secondary">
                        <input type="checkbox" id="include_ipv4_only" checked>
                        Include IPv4-only trackers
                    </label>
                </p>
            </div>
            <div class="col-lg-3">
                <p>
                    <label class="btn btn-secondary">
                        <input type="checkbox" id="include_ipv6_only">
                        Include IPv6-only trackers
                    </label>
                </p>
            </div>
            <div class="col-lg-3">
                <p>
                    <label class="btn btn-secondary">
                        <input type="checkbox" id="include_trackers_newer_than_10_days">
                        Include trackers newer than 7 days
                    </label>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3">
                <p>
                    <label for="region" class="form-label">Located in</label>
                    <select class="form-select" id="region">
                        <option value="" selected>Anywhere</option>
                        <option value="americas">Americas</option>
                        <option value="europe">Europe, Middle East &amp; Africa</option>
                        <option value="asia-pacific">Asia-Pacific</option>
                    </select>
                </p>
            </div>
            <div class="col-lg-3">
                <p>
                    <label for="fast_from" class="form-label">Fast from</label>
                    <select class="form-select" id="fast_from">
                        <option value="" selected>Anywhere</option>
                        <option value="americas">Americas</option>
                        <option value="europe">Europe, Middle East &amp; Africa</option>
                        <option value="asia">Asia</option>
                        <option value="oceania">Australia, New Zealand &amp; Pacific</option>
                    </select>
                </p>
            </div>
        </div>
        <div class="alert alert-info" id="region-note" style="display:none"></div>
        <div id="list">
            <pre id="tocopy">Loading...</pre>
        </div>
    </div>
{% endblock %}
{% set title = "Stable Trackers List - newTrackon" %}
