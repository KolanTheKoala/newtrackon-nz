{% extends "base.jinja" %}
{% block head %}
    <script>
    // "… ago" for the submission times (replaces moment.js + livestamp)
    (function () {
      function f(s) {
        var m = Math.floor(s / 60), h = Math.floor(m / 60), d = Math.floor(h / 24);
        if (s < 60) return 'just now';
        if (d > 0) return d + 'd ' + (h % 24) + 'h ago';
        if (h > 0) return h + 'h' + (m % 60 ? ' ' + (m % 60) + 'm' : '') + ' ago';
        return m + 'm ago';
      }
      function run() {
        var n = Date.now() / 1000;
        document.querySelectorAll('[data-nt-ago]').forEach(function (e) {
          var t = +e.getAttribute('data-nt-ago');
          if (t) { e.textContent = f(Math.max(0, n - t)); e.title = new Date(t * 1000).toLocaleString(); }
        });
      }
      document.addEventListener('DOMContentLoaded', run);
      setInterval(run, 30000);
    })();
    </script>
{% endblock head %}
{% macro eta(s) -%}
    {%- if s < 60 %}~{{ [s, 5]|max }} s{% elif s < 3600 %}~{{ (s / 60)|round|int }} min{% else %}~{{ s // 3600 }} h {{ ((s % 3600) / 60)|round|int }} min{% endif -%}
{%- endmacro %}
{% block body %}
    <style>
        /* the tracker-page icon, as in the status table */
    .nt-tlink { margin-left: .45em; font-size: .85em; color: #c15cff !important; } .nt-tlink:hover { color: #e0a8ff !important; }
    /* beats base.jinja's white/grey table-link rules (one more :not(#id) = higher specificity) */
    table tbody tr:not(#_nt) > *:not(#_nt) a.nt-tlink:not(#_nt):not(#_nt2), table tbody tr:not(#_nt) > *:not(#_nt) a.nt-tlink:not(#_nt):not(#_nt2):visited { color: #c15cff !important; }
    table tbody tr:not(#_nt) > *:not(#_nt) a.nt-tlink:not(#_nt):not(#_nt2):hover { color: #e0a8ff !important; }
        /* queued submissions: greyed out until they've been tried */
        /* same strength as base.jinja's nt-navy-rows (white text in every cell), so this wins */
        table tbody tr.nt-pending:not(#_nt) > *:not(#_nt), table tbody tr.nt-pending:not(#_nt) > *:not(#_nt) * { color: #8b93a1 !important; }
        table tbody tr.nt-pending:not(#_nt) > td.pending:not(#_nt) { background: #1f2a3d !important; }
        /* Result: Accepted always green, Rejected always red (outranks the white text of the site-wide row rule) */
        table tbody tr:not(#_nt) > td.up:not(#_nt), table tbody tr:not(#_nt) > td.up:not(#_nt) * { color: #00e676 !important; }
        table tbody tr:not(#_nt) > td.rejected:not(#_nt), table tbody tr:not(#_nt) > td.rejected:not(#_nt) * { color: #ff3b30 !important; }
        /* phones: one card per submission. Time and result on the first line, the URL below, then the tracker's
           reply in small type that wraps anywhere (a five-column table left it four letters wide). */
        @media (max-width: 576px) {
            table.nt-sub, table.nt-sub tbody, table.nt-sub tr, table.nt-sub td { display: block !important; width: 100% !important; }
            table.nt-sub thead, table.nt-sub .c-ip, table.nt-sub td:empty { display: none !important; }
            table.nt-sub tr { border: 1px solid #2c3b57; border-radius: .5rem; margin-bottom: .6rem; padding: .45rem .6rem; overflow: hidden; }
            table.nt-sub tr > td { border: 0 !important; padding: .1rem 0 !important; white-space: normal !important; background: transparent !important; box-shadow: none !important; }
            table.nt-sub td.t, table.nt-sub td.res { display: inline-block !important; width: auto !important; font-size: .85rem; }
            table.nt-sub td.t { margin-right: .8rem; color: #9aa6ba !important; }
            table.nt-sub td.u { font-size: .95rem; overflow-wrap: anywhere; word-break: break-all; margin: .15rem 0; }
            table.nt-sub td.msg { font-size: .78rem; line-height: 1.35; overflow-wrap: anywhere; word-break: break-word; color: #b8c2d3 !important; max-height: 9.5em; overflow-y: auto; }
            .table-responsive { overflow-x: visible !important; }
            /* no row striping inside a card (outranks base.jinja's navy-row rules: one more class) */
            table.nt-sub tbody tr:not(#_nt) > *:not(#_nt) { background: transparent !important; box-shadow: none !important; }
        }
    </style>
    <div class="container">
        <h2>Submitted Trackers</h2>
        <p>
            This is the information about the last 600 tried trackers. To make it to the queue, a tracker has to be a
            well-formed URL, not to be an IP, and resolve at least to an IP address.
        </p>
        <p>
            newTrackon respects <a href="https://www.bittorrent.org/beps/bep_0034.html">BEP34</a>. If no BEP34 records are
            found, trackers are tried (in this order) with UDP, HTTP and HTTPS. When one protocol succeeds,
            it gets added to the list, whatever its announce interval (this site sets its own check schedule). If no port is specified, the tracker is tried only with HTTP on port 80 and HTTPS on port 443. For HTTP/S, trackers must return a
            <a href="https://www.bittorrent.org/beps/bep_0023.html">compact peer list</a>.
        </p>
        <p>A tracker that answers is checked once more 30 minutes later, and listed only if it answers then too, so one answer
            from a machine that then goes away doesn't get it listed.</p>
        <p>The queue is processed at about 10 seconds per URL tried. If a working UDP version of a tracker already listed over HTTP/HTTPS is submitted, it replaces that entry and keeps its history.</p>
        {% set bans = nt_bans() %}
        <p>
            <b>Number of trackers in the queue: {{ size }}</b>
            {% if bans %}&middot; <a href="/bans">{{ bans|length }} banned tracker{{ "" if bans|length == 1 else "s" }}</a>{% endif %}
        </p>
    </div>
    {% if data or pending or confirming %}
        <div class="container-fluid">
            <div class="table-responsive">
                <table class="sortable table table-responsive table-striped table-bordered initially-hidden nt-sub">
                    <thead>
                        <tr>
                            <th class="t">Time</th>
                            <th class="u">URL</th>
                            <th class="c-ip">IP</th>
                            <th class="r">Result</th>
                            <th>Response/Error</th>
                        </tr>
                    </thead>
                    {# the queue: newest at the top, position 1 (checked now or next) at the bottom, just above the results #}
                    {% if size > pending|length %}
                        <tr class="nt-pending"><td></td><td colspan="4" class="msg">&hellip; and {{ size - pending|length }} more waiting behind these</td></tr>
                    {% endif %}
                    {% for c in confirming %}
                        <tr class="nt-pending">
                            <td class="t"></td>
                            <td class="u">{{ c.url }}</td>
                            <td class="c-ip"></td>
                            <td class="pending res"><b>Pending</b></td>
                            <td class="msg">Answered once &middot; second check in {{ eta(c.eta) }}, then listed if it answers</td>
                        </tr>
                    {% endfor %}
                    {% for p in pending|reverse %}
                        <tr class="nt-pending">
                            <td class="t">{% if p.time %}<span data-nt-ago="{{ p.time }}"></span>{% endif %}</td>
                            <td class="u">{{ p.url }}</td>
                            <td class="c-ip"></td>
                            <td class="pending res"><b>Pending</b></td>
                            <td class="msg">{% if p.checking %}Being checked now{% else %}Queue position {{ p.pos }} &middot; ETA {{ eta(p.eta) }}{% endif %}</td>
                        </tr>
                    {% endfor %}
                    {% for response in data %}
                        {% set nt_noup = response.get("noupgrade") or "not answering: it stays listed as" in ((response['info'] or [])|join(' ')) %}
                        <tr{% if response.get("refused") or response.get("confirm") or nt_noup %} class="nt-pending"{% endif %}>
                            <td class="t">
                                <span data-nt-ago="{{ response['time'] }}"></span>
                            </td>
                            <td class="u">{{ response['url'] }}{% if response.get("refused") and (response.get("ban_host") or ((response['info'] or [''])[0]).startswith("Banned")) %}{% set h = response.get("ban_host") or nt_host(response['url']) %}<a href="/tracker/{{ h|urlencode }}" class="nt-tlink" title="Why it was removed, and how to get it back"><i class="fa-solid fa-chart-line"></i></a>{% endif %}{% if response["status"] == 1 %}{% set h = nt_host(response['url']) %}{% if h %}<a href="/tracker/{{ h|urlencode }}" class="nt-tlink" title="Tracker page: uptime and latency history"><i class="fa-solid fa-chart-line"></i></a>{% endif %}{% endif %}</td>
                            <td class="c-ip">{{ response.get('ip', '') }}</td>
                            {% if response["status"] == 1 %}
                                <td class="up res">
                                    <b>Accepted</b>
                                </td>
                            {% elif nt_noup %}
                                <td class="pending res" title="The listed tracker is fine and unchanged: only the better protocol didn't answer">
                                    <b>Not upgraded</b>
                                </td>
                            {% elif response.get("confirm") %}
                                <td class="pending res" title="Answered once: listed only if it answers again 30 minutes later">
                                    <b>Pending</b>
                                </td>
                            {% elif response.get("refused") %}
                                <td class="pending res" title="Not checked: refused before it reached the queue">
                                    <b>Refused</b>
                                </td>
                            {% else %}
                                <td class="rejected res">
                                    <b>Rejected</b>
                                </td>
                            {% endif %}
                            <td class="msg">
                                {% for message in response['info'] %}
                                    {{ message | e }}
                                    <br>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
    {% endif %}
    <div class="container mt-4" id="banned">
        <p>Removed trackers can't be submitted again for a while: see the <a href="/bans">banned trackers</a>{% if bans %} ({{ bans|length }} now){% endif %}.</p>
    </div>
    <script>
        $(document).ready(function () {
            $(".initially-hidden").css("visibility", "visible");
        });
    </script>
{% endblock %}
{% set title = "Submitted Trackers - newTrackon" %}
