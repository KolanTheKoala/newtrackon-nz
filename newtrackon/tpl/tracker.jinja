{% extends "base.jinja" %}
{% block head %}
<link rel="alternate" type="application/atom+xml" title="Status changes for {{ t.host }}" href="/feed.xml?tracker={{ t.host|urlencode }}">
<script type="application/ld+json">{{ ld|tojson }}</script>
    <style>
    .nt-t h2 { word-break: break-all; }
    .nt-t .nt-badge { font-size: 1rem; padding: .3em .7em; border-radius: 4px; font-weight: 600; }
    .nt-t .nt-badge.green { background: #051b11; color: #00e676; border: 1px solid #75b798; }
    .nt-t .nt-badge.orange { background: #331a00; color: #ffb070; border: 1px solid #ffb070; }
    .nt-t .nt-badge.new { background: #04202b; color: #4fc3f7; border: 1px solid #4fc3f7; }
    .nt-t .nt-badge.offline { background: #000; color: #bbb; border: 1px solid #666; }
    .nt-t dl { display: grid; grid-template-columns: max-content 1fr; gap: .3rem 1.2rem; margin: 0; }
    .nt-t dt { font-weight: 600; } .nt-t dd { margin: 0; word-break: break-word; }
    .nt-days { display: flex; align-items: flex-end; gap: 3px; height: 70px; }
    .nt-days div { flex: 1; max-width: 28px; border-radius: 2px 2px 0 0; min-height: 2px; }
    .nt-strip { display: flex; gap: 1px; height: 18px; }
    .nt-strip div { flex: 1; border-radius: 1px; }
    .nt-up { background: #00c853; } .nt-part { background: #ffa000; } .nt-down { background: #d32f2f; }
    .nt-long { display: block; height: 60px; } .nt-long .nt-up { fill: #00c853; } .nt-long .nt-part { fill: #ffa000; } .nt-long .nt-down { fill: #d32f2f; }
    .nt-months td.l { white-space: normal !important; font-size: .85rem; }
    .nt-axis { display: flex; justify-content: space-between; font-size: .8rem; opacity: .75; }
    .nt-chart text { fill: currentColor; font-size: 11px; opacity: .75; }
    .nt-chart .grid { stroke: currentColor; stroke-opacity: .15; }
    .nt-legend > span { margin-right: 1.2rem; white-space: nowrap; }
    .nt-legend i { display: inline-block; width: 14px; height: 3px; vertical-align: middle; margin-right: .35rem; }
    .nt-problem { border: 1px solid #ffb070; background: rgba(255, 145, 0, .08); border-radius: 6px; padding: .8rem 1rem; margin-bottom: 1rem; }
    .nt-t .nt-stt { display: grid; grid-template-columns: max-content 1fr; gap: 2px 18px; }
    .nt-t .nt-stt > .k { opacity: .65; } .nt-t .nt-stt > .v { font-weight: 600; }
    .nt-t .nt-stt > .tot { opacity: 1; font-weight: 700; border-top: 1px solid rgba(127, 127, 127, .4); padding-top: 2px; }
    .nt-t .nt-stt > .sep { grid-column: 1 / -1; height: 8px; }
    @media (max-width: 576px) {
        .nt-t .nt-turl { font-size: 1.15rem; }
        .nt-chart text { font-size: 26px; }
        .nt-t dl, .nt-t .nt-stt { grid-template-columns: 1fr; gap: 0; }
        .nt-t dd, .nt-t .nt-stt > .v { margin-bottom: .45rem; }
        .nt-legend > span { display: block; }  /* each region on its own line; not the ms inside */
    }
    .nt-ivnote { color: #ffb070; font-size: .9em; }
    .nt-ev td { padding: .25rem .8rem .25rem 0; vertical-align: top; }
    .nt-ev td:last-child { white-space: normal !important; }
    table.nt-ev { margin-left: 0; }  /* left-aligned like the rest of the page (tables are centred site-wide) */  /* event text wraps on phones */
    </style>
{% endblock head %}
{% block body %}
<div class="container nt-t">
    {% set u = t.url.split('://', 1) %}{% set hp = u[1].split('/', 1) %}
    <h2 class="mt-2 nt-turl">{{ u[0] }}://<wbr>{{ hp[0].rsplit(':', 1)[0] }}{% if ':' in hp[0] %}<wbr>:{{ hp[0].rsplit(':', 1)[1] }}{% endif %}{% if hp|length > 1 %}<wbr>/{{ hp[1] }}{% endif %}</h2>
    <p class="nt-isdown mb-2">Is it down? <b>{% if down %}Yes: no answer for {{ down_for }}{% else %}No: up for {{ down_for }}{% endif %}</b> &middot; last checked {{ checked_txt }}</p>
    <p class="mb-3">
        <span class="nt-badge {{ 'new' if d.status == 'up_new' else row }}">{{ status_text }}</span>
        &nbsp; Score <b>{{ d.score|round|int }}</b>
        {% if d.latency_ms is not none %} &middot; <b>{{ d.latency_ms }} ms</b>{% endif %}
        {% if d.country_codes %} &middot; <span class="fi fi-{{ d.country_codes[0] }}"></span> {{ d.countries[0] if d.countries else '' }}{% endif %}
        &middot; <a href="/#q={{ t.host|urlencode }}">Show in the table</a> &middot; <a href="/map">Map</a>
        &middot; <a href="/feed.xml?tracker={{ t.host|urlencode }}" title="Atom feed of this tracker's status changes: add it to a feed reader"><i class="fa-solid fa-rss"></i> Follow</a>
    </p>
    {% if fix %}
    <div class="nt-problem">
        <h5>What's wrong: {{ fix_title }}</h5>
        <ul class="mb-2">{% for e in evidence %}<li>{{ e }}</li>{% endfor %}</ul>
        <a href="/fix#{{ fix }}" class="btn btn-sm btn-warning"><i class="fa-solid fa-wrench"></i> How to fix it</a>
    </div>
    {% endif %}
    <form method="post" action="/tracker/{{ t.host|urlencode }}/recheck" class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-rotate"></i> Check again now</button>
        <span class="small">
        {% if recheck == 'queued' %}Queued: it's checked next, usually within a minute or two. Reload this page to see the result.
        {% elif recheck == 'wait' %}It was checked on request recently; try again in {{ recheck_m }} min.
        {% elif recheck == 'busy' %}Too many requested checks this hour; try again later.
        {% else %}Fixed something? Ask for a check now instead of waiting for the next one (once an hour per tracker).{% endif %}
        </span>
    </form>

    <h5 class="mt-4">Uptime, last {{ days|length }} days</h5>
    {% if days %}
    <div class="nt-days">
        {% for x in days %}<div class="{{ 'nt-up' if x.pct >= 99 else ('nt-part' if x.pct >= 50 else 'nt-down') }}" style="height: {{ [x.pct, 3]|max }}%"
             title="{{ 'Last 24 hours' if x.ago == 0 else (x.ago|string + '–' + (x.ago + 1)|string + ' days ago') }}: {{ x.pct }}% up"></div>{% endfor %}
    </div>
    <div class="nt-axis"><span>{{ days|length }} days ago</span><span>now</span></div>
    {% else %}<p>Not enough history yet (listed {{ history_days }} days).</p>{% endif %}

    {% if long %}
    <h5 class="mt-4">Long-term uptime</h5>
    <p class="small mb-1">Up {{ long.pct }}% of the time over {{ long.days }} days, since {{ long.since }}.</p>
    <svg class="nt-long" viewBox="0 0 {{ long.strip|length }} 100" preserveAspectRatio="none" width="100%" role="img" aria-label="Daily uptime, last {{ long.strip|length }} days">
        {% for x in long.strip %}{% set ht = [x.pct, 3]|max %}<rect x="{{ loop.index0 }}" y="{{ 100 - ht }}" width="1" height="{{ ht }}" class="{{ 'nt-up' if x.pct >= 99 else ('nt-part' if x.pct >= 50 else 'nt-down') }}"><title>{{ x.day }}: {{ x.pct }}% up</title></rect>{% endfor %}
    </svg>
    <div class="nt-axis"><span>{{ long.strip[0].day }}</span><span>{{ long.strip[-1].day }}</span></div>
    <table class="table table-sm nt-months mt-2" style="margin-left:0">
        <thead><tr><th>Month</th><th>Uptime</th><th>Typical latency</th></tr></thead>
        <tbody>{% for m in long.months %}<tr><td>{{ m.month }}{% if m.days < 28 %} <span class="small">({{ m.days }} d)</span>{% endif %}</td><td>{{ m.pct }}%</td>
            <td class="l">{% for r, ms in m.lat %}{{ r }} {{ ms }}&nbsp;ms{% if not loop.last %} &middot; {% endif %}{% else %}&ndash;{% endfor %}</td></tr>{% endfor %}</tbody>
    </table>
    {% endif %}

    <h5 class="mt-4">Last 48 hours</h5>
    <div class="nt-strip">
        {% for x in recent %}<div class="{{ 'nt-up' if x > 0 else 'nt-down' }}" title="{{ ((recent|length - loop.index) / 2)|round(1) }} h ago: {{ 'up' if x > 0 else 'down' }}"></div>{% endfor %}
    </div>
    <div class="nt-axis"><span>{{ (recent|length / 2)|round|int }} h ago</span><span>now</span></div>

    <h5 class="mt-4">Latency by region</h5>
    {% if chart %}
    <svg class="nt-chart" viewBox="0 0 {{ chart.w }} {{ chart.h }}" width="100%" role="img" aria-label="Latency by region over time">
        {% for g in chart.grid %}<line class="grid" x1="{{ chart.pad }}" x2="{{ chart.w - 8 }}" y1="{{ g.y }}" y2="{{ g.y }}"/><text x="{{ chart.pad - 4 }}" y="{{ g.y + 4 }}" text-anchor="end">{{ g.ms }}</text>{% endfor %}
        {% for tk in chart.ticks %}<text x="{{ tk.x }}" y="{{ chart.h - 4 }}" text-anchor="{{ tk.anchor|default('middle') }}">{{ tk.label }}</text>{% endfor %}
        {% for l in chart.lines %}
            {% for pts in l.parts %}<polyline fill="none" stroke="{{ l.color }}" stroke-width="2" stroke-linejoin="round" points="{{ pts }}"/>{% endfor %}
            {% for c in l.dots %}{% set xy = c[0].split(',') %}<circle cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="2.5" fill="{{ l.color }}"/>{% endfor %}
        {% endfor %}
    </svg>
    <div class="nt-legend">{% for l in chart.lines %}<span><i style="background: {{ l.color }}"></i>From {{ l.region }}: {{ l.last }} ms now</span>{% endfor %}</div>
    <p class="small mt-1">Announce round trip, in ms, from each place latency is measured. Recorded every 2 hours, kept 30 days.</p>
    {% else %}<p>No latency measured yet.</p>{% endif %}

    <h5 class="mt-4">Score</h5>
    {% set s = t.stats or {} %}<div class="nt-stt">{% if s.base is defined %}<span class="k">Recent availability</span><span class="v">{{ s.avail_weighted }}%</span><span class="k" title="How steadily it stays up, weighted towards recent checks. 100% means it never flipped between up and down. Constantly dropping in and out pulls this down far more than one long outage does." style="cursor:help;text-decoration:underline dotted">Stability</span><span class="v" title="How steadily it stays up, weighted towards recent checks. 100% means it never flipped between up and down. Constantly dropping in and out pulls this down far more than one long outage does.">&times; {{ s.stability }}%</span><span class="k">Reliability score</span><span class="v">= {{ s.base_r }}</span>{% if s.ceiling is defined and s.ceiling < s.base %}<span class="k">New-tracker ceiling</span><span class="v">held to {{ s.ceiling_r }} (under 7 days old)</span>{% endif %}<span class="k">Latency penalty</span><span class="v">{% set nt_c = ([s.base_r, s.ceiling_r]|min if s.ceiling_r is defined else s.base_r) %}{% set nt_p = (s.lat_penalty|round|int) if s.capped else (nt_c - ((t.uptime + 0.5)|int) - (s.iv_penalty or 0)) %}{% if s.lat_penalty and nt_p >= 1 %}&minus;{{ nt_p }}{% elif s.lat_penalty %}under 1{% else %}none{% endif %}</span>{% if s.iv_penalty %}<span class="k">Announce interval</span><span class="v" title="Its announce interval ({{ (s.iv / 60)|round|int }} min) is far from the usual 30 to 60 minutes. Points off for ranking only: it doesn't change the status.">&minus;{{ s.iv_penalty }} (every {{ (s.iv / 60)|round|int if s.iv >= 60 else s.iv }}{{ " min" if s.iv >= 60 else " s" }}, see Details)</span>{% endif %}{% if s.capped %}<span class="k">Quality cap</span><span class="v">capped for failing a quality test (see Status)</span>{% endif %}<span class="k tot">Score</span><span class="v tot">{{ (t.uptime + 0.5)|int }}</span><span class="sep"></span>{% endif %}{% if s.avail7 is defined %}<span class="k">Last 7 days</span><span class="v">answered {{ s.avail7 }}% of checks &middot; {{ s.outages7 }} outage{{ "" if s.outages7 == 1 else "s" }}</span>{% if s.avail_all is defined %}<span class="k">Since added</span><span class="v">answered {{ s.avail_all }}% over {{ s.days }} days{% if s.longest_h %} &middot; longest outage {{ s.longest_h }}&nbsp;h{% endif %}</span>{% endif %}{% endif %}</div>

    <h5 class="mt-4">Details</h5>
    <dl>
        <dt>IP addresses</dt><dd>{{ d.ips|join(', ') or '—' }}</dd>
        <dt>Network</dt><dd>{{ d.networks|join(', ') or '—' }}</dd>
        <dt>Located in</dt><dd>{{ d.countries|join(', ') or '—' }}</dd>
        <dt>IPv4 / IPv6</dt><dd>{{ d.families.v4|replace('_', ' ') }} / {{ d.families.v6|replace('_', ' ') }}{% for k, a in fam_answers.items() %}<br><span class="small">IPv{{ k[-1] }} answered {{ a[0] }} of the last {{ a[1] }} checks</span>{% endfor %}</dd>
        <dt>Peer test</dt><dd>{{ d.peer_test.latest }} (passed {{ d.peer_test.passed }} of the last {{ d.peer_test.of }})</dd>
        <dt>Checked every</dt><dd>{{ (d.check_interval_s / 60)|round|int }} min, last {{ checked_ago }} ago</dd>
        {% if d.announce_interval_s %}<dt>Announce interval</dt><dd>{% if d.announce_interval_s < 60 %}{{ d.announce_interval_s }} s{% else %}{{ (d.announce_interval_s / 60)|round|int }} min{% endif %}{% if iv_note %} <span class="nt-ivnote">({{ iv_note }})</span>{% endif %}</dd>{% endif %}
        {% if warn %}<dt>Message from the tracker</dt><dd>&ldquo;{{ warn[0] }}&rdquo;{% if warn[1] %}<br><span class="small">{{ warn[1] }}</span>{% endif %}</dd>{% endif %}
        <dt>Added</dt><dd>{{ t.added|format_date }} ({{ added_ago }} ago)</dd>
        {% if d.same_operator_as %}<dt>Same operator as</dt><dd>{% for u in d.same_operator_as %}{{ u }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>{% endif %}
    </dl>

    <h5 class="mt-4">Recent events</h5>
    {% if events %}
    <table class="nt-ev mb-4">
        {% for e in events %}<tr><td class="text-nowrap">{{ e.ago }} ago</td><td>{{ e.text }}</td></tr>{% endfor %}
    </table>
    {% else %}<p class="mb-4">No status changes recorded recently.</p>{% endif %}

    {% if d.status in ("up_good", "up_new", "up_slow") %}{# only healthy trackers are offered a badge; an embedded one stays honest if it later degrades #}
    {% set bu = "https://newtrackon.co.nz/badge/" ~ (t.host|urlencode) ~ ".svg" %}{% set pu = "https://newtrackon.co.nz/tracker/" ~ (t.host|urlencode) %}
    <h5 class="mt-4">Status badge</h5>
    <p>For the tracker's own site or README: it shows the live status and links back here.</p>
    <p><img src="/badge/{{ t.host|urlencode }}.svg" alt="newTrackon NZ status of {{ t.host }}" height="20"></p>
    <label class="form-label small mb-1">Markdown</label>
    <input class="form-control form-control-sm mb-2 font-monospace" readonly onclick="this.select()" value="[![newTrackon NZ status]({{ bu }})]({{ pu }})">
    <label class="form-label small mb-1">HTML</label>
    <input class="form-control form-control-sm mb-4 font-monospace" readonly onclick="this.select()" value='<a href="{{ pu }}"><img src="{{ bu }}" alt="newTrackon NZ status" height="20"></a>'>
    {% endif %}
</div>
{% endblock %}
